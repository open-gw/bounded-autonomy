{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bounded-autonomy.io/schemas/result.schema.json",
  "title": "RunResult",
  "description": "Study-design §5.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "mode",
    "seed",
    "started_at",
    "finished_at",
    "wall_clock_seconds",
    "declaration",
    "steps_completed",
    "write_counts",
    "metrics",
    "policy_propagation_ms",
    "artefacts",
    "source"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "profile": { "enum": ["long-multistep", "data-intensive", "redeclaration"] },
    "mode": { "enum": ["flat", "full", "gateway-only", "gateway-bypass"] },
    "gateway_bypass": { "type": "boolean" },
    "seed": { "type": "integer", "minimum": 0 },
    "source": { "enum": ["simulator", "cluster"] },
    "variant": { "enum": ["k1", "k3", "k5", "k7"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "wall_clock_seconds": { "type": "number", "minimum": 0 },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "spiffe_id",
        "services",
        "expected_duration_seconds",
        "granularity"
      ],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "spiffe_id": {
          "type": "string",
          "pattern": "^spiffe://rig/task/.+$"
        },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "declared_count": { "enum": [1, 3, 5, 7] },
        "variant": { "enum": ["k1", "k3", "k5", "k7"] },
        "expected_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "expected_step_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "granularity": { "enum": ["task", "step"] }
      }
    },
    "steps_completed": { "type": "integer", "minimum": 0, "maximum": 30 },
    "write_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotent", "versioned", "derived", "irreversible"],
      "properties": {
        "idempotent": { "type": "integer", "minimum": 0 },
        "versioned": { "type": "integer", "minimum": 0 },
        "derived": { "type": "integer", "minimum": 0 },
        "irreversible": { "type": "integer", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reachable_set_size",
        "reachable_services",
        "reachable_weight",
        "credential_ratio",
        "credential_ratio_derivation",
        "tau_seconds",
        "T_seconds",
        "tau_issued_epoch",
        "tau_not_after_epoch",
        "T_start_epoch",
        "T_end_epoch",
        "residual_svid_seconds",
        "residual_policy_seconds",
        "entry_deleted_at_epoch",
        "policy_removed_at_epoch",
        "task_end_epoch",
        "credential_kind",
        "rollback_completeness",
        "rho_enum",
        "verification_overhead",
        "segment_p_ms",
        "segment_q_ms",
        "step_ratio_mean",
        "step_ratio_max",
        "d_ms_mean",
        "d_ms_max"
      ],
      "properties": {
        "reachable_set_size": { "type": "integer", "minimum": 0 },
        "reachable_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reachable_weight": { "type": "integer", "minimum": 0 },
        "credential_ratio": { "type": ["number", "null"] },
        "credential_ratio_derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["formula", "tau_definition", "tau_seconds", "T_seconds", "credential_kind"],
          "properties": {
            "formula": { "type": "string", "minLength": 1 },
            "tau_definition": { "type": "string", "minLength": 1 },
            "tau_seconds": { "type": ["number", "null"] },
            "T_seconds": { "type": ["number", "null"] },
            "credential_kind": { "enum": ["jwt-svid", "sa-token", "svid"] }
          }
        },
        "tau_seconds": { "type": ["number", "null"] },
        "T_seconds": { "type": ["number", "null"] },
        "tau_issued_epoch": { "type": ["number", "null"] },
        "tau_not_after_epoch": { "type": ["number", "null"] },
        "T_start_epoch": { "type": ["number", "null"] },
        "T_end_epoch": { "type": ["number", "null"] },
        "residual_svid_seconds": { "type": ["number", "null"] },
        "residual_policy_seconds": { "type": ["number", "null"] },
        "entry_deleted_at_epoch": { "type": ["number", "null"] },
        "policy_removed_at_epoch": { "type": ["number", "null"] },
        "task_end_epoch": { "type": ["number", "null"] },
        "credential_kind": { "enum": ["jwt-svid", "sa-token", "svid"] },
        "rollback_completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idempotent", "versioned", "derived", "irreversible"],
          "properties": {
            "idempotent": { "$ref": "#/$defs/classIdempotent" },
            "versioned": { "$ref": "#/$defs/classVersioned" },
            "derived": { "$ref": "#/$defs/classDerived" },
            "irreversible": { "$ref": "#/$defs/classIrreversible" }
          }
        },
        "rho_enum": { "type": ["number", "null"] },
        "verification_overhead": {
          "type": "object",
          "additionalProperties": false,
          "required": ["absolute_seconds", "relative", "verify_ms", "total_ms"],
          "properties": {
            "absolute_seconds": { "type": "number" },
            "relative": { "type": ["number", "null"] },
            "verify_ms": { "type": "number", "minimum": 0 },
            "total_ms": { "type": "number", "minimum": 0 }
          }
        },
        "segment_p_ms": { "type": ["number", "null"] },
        "segment_q_ms": { "type": ["number", "null"] },
        "step_ratio_mean": { "type": ["number", "null"] },
        "step_ratio_max": { "type": ["number", "null"] },
        "d_ms_mean": { "type": ["number", "null"] },
        "d_ms_max": { "type": ["number", "null"] },
        "breach_services": {
          "type": "array",
          "items": { "type": "string" }
        },
        "breach_intersection": {
          "type": "array",
          "items": { "type": "string" }
        },
        "breach_intersection_size": { "type": "integer", "minimum": 0 },
        "gateway_403": { "type": "integer", "minimum": 0 }
      }
    },
    "policy_propagation_ms": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "redeclaration_cost_ms": { "type": ["number", "null"], "minimum": 0 },
    "steps_reexecuted": { "type": "integer", "minimum": 0 },
    "writes_committed_before_termination": { "type": "boolean" },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probe": { "type": "boolean" }
      }
    },
    "step_cost_split": { "$ref": "#/$defs/stepCostSplit" },
    "evasion_matrix": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/evasionRow" }
    },
    "artefacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "flows", "spans", "lineage", "groundtruth", "svid"],
      "properties": {
        "probe": { "type": "string" },
        "flows": { "type": "string" },
        "spans": { "type": "string" },
        "lineage": { "type": "string" },
        "groundtruth": { "type": "string" },
        "svid": { "type": "string" },
        "evasion": { "type": "string" },
        "gateway": { "type": "string" }
      }
    }
  },
  "$defs": {
    "classIdempotent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rho_rev", "n", "restored"],
      "properties": {
        "rho_rev": { "type": ["number", "null"] },
        "n": { "type": "integer", "minimum": 0 },
        "restored": { "type": "integer", "minimum": 0 },
        "rho_enum": { "type": ["number", "null"] },
        "rho_quarantined": { "type": ["number", "null"] },
        "rho_escalated": { "type": ["number", "null"] }
      }
    },
    "classVersioned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rho_rev", "n", "restored"],
      "properties": {
        "rho_rev": { "type": ["number", "null"] },
        "n": { "type": "integer", "minimum": 0 },
        "restored": { "type": "integer", "minimum": 0 },
        "rho_enum": { "type": ["number", "null"] },
        "rho_quarantined": { "type": ["number", "null"] },
        "rho_escalated": { "type": ["number", "null"] }
      }
    },
    "classDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rho_rev", "n", "quarantined"],
      "properties": {
        "rho_rev": { "type": ["number", "null"] },
        "n": { "type": "integer", "minimum": 0 },
        "quarantined": { "type": "integer", "minimum": 0 },
        "rho_enum": { "type": ["number", "null"] },
        "rho_quarantined": { "type": ["number", "null"] },
        "rho_escalated": { "type": ["number", "null"] }
      }
    },
    "evasionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "probe", "verdict", "latency_ms"],
      "properties": {
        "row": { "type": "integer", "minimum": 1, "maximum": 9 },
        "id": { "type": "string", "minLength": 1 },
        "probe": { "type": "string", "minLength": 1 },
        "target": { "type": "string" },
        "verdict": {
          "enum": ["allowed", "refused", "error", "host-refused"]
        },
        "latency_ms": { "type": "number", "minimum": 0 },
        "detail": { "type": "string" },
        "leak": { "enum": ["", "name-resolution", "reach"] },
        "policy_propagation_ms": { "type": "number", "minimum": 0 },
        "probe_epoch": { "type": "number" },
        "cnp_valid_epoch": { "type": "number" },
        "seconds_after_cnp_valid": { "type": "number", "minimum": 0 }
      }
    },
    "stepCostSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_enabled", "boundaries", "totals", "reconcile_error_pct"],
      "properties": {
        "probe_enabled": { "type": "boolean" },
        "boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/stepCostBoundary" }
        },
        "totals": { "$ref": "#/$defs/stepCostTotals" },
        "reconcile_error_pct": { "type": "number", "minimum": 0 },
        "reconcile_ok": { "type": "boolean" }
      }
    },
    "stepCostBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step",
        "propagation_ms",
        "svid_reissue_ms",
        "probe_ms",
        "other_ms",
        "boundary_ms"
      ],
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "propagation_ms": { "type": "number", "minimum": 0 },
        "svid_reissue_ms": { "type": "number", "minimum": 0 },
        "probe_ms": { "type": "number", "minimum": 0 },
        "other_ms": { "type": "number" },
        "boundary_ms": { "type": "number", "minimum": 0 }
      }
    },
    "stepCostTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propagation_ms",
        "svid_reissue_ms",
        "probe_ms",
        "other_ms",
        "boundary_ms"
      ],
      "properties": {
        "propagation_ms": { "type": "number" },
        "svid_reissue_ms": { "type": "number" },
        "probe_ms": { "type": "number" },
        "other_ms": { "type": "number" },
        "boundary_ms": { "type": "number" }
      }
    },
    "classIrreversible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rho_rev", "n", "escalated"],
      "properties": {
        "rho_rev": { "type": ["number", "null"] },
        "n": { "type": "integer", "minimum": 0 },
        "escalated": { "type": "integer", "minimum": 0 },
        "rho_enum": { "type": ["number", "null"] },
        "rho_quarantined": { "type": ["number", "null"] },
        "rho_escalated": { "type": ["number", "null"] }
      }
    }
  }
}
