{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bounded-autonomy.io/schemas/manifest.schema.json",
  "title": "RunManifest",
  "description": "Study-design §1. Additional rule (not expressible here): write_mix sums to 1.0 ± 1e-9, and declared ∪ undeclared equals the eight rig services.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "bounded-autonomy.io/v1" },
    "kind": { "const": "RunManifest" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "created"],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "mode",
        "seed",
        "steps",
        "expected_duration_seconds",
        "write_mix",
        "services",
        "injection",
        "cluster"
      ],
      "properties": {
        "profile": { "enum": ["long-multistep", "data-intensive", "redeclaration"] },
        "variant": { "enum": ["k1", "k3", "k5", "k7"] },
        "mode": { "enum": ["flat", "full", "gateway-only", "gateway-bypass"] },
        "gateway_bypass": { "type": "boolean" },
        "seed": { "type": "integer", "minimum": 0 },
        "steps": { "type": "integer", "minimum": 1, "maximum": 30 },
        "expected_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "expected_step_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "write_mix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idempotent", "versioned", "derived", "irreversible"],
          "properties": {
            "idempotent": { "type": "number", "minimum": 0, "maximum": 1 },
            "versioned": { "type": "number", "minimum": 0, "maximum": 1 },
            "derived": { "type": "number", "minimum": 0, "maximum": 1 },
            "irreversible": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "services": {
          "type": "object",
          "additionalProperties": false,
          "required": ["declared", "undeclared"],
          "properties": {
            "declared_count": { "enum": [1, 3, 5, 7] },
            "declared": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "undeclared": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "injection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "at_step",
            "undeclared_service",
            "undeclared_store",
            "payload_version"
          ],
          "properties": {
            "enabled": { "type": "boolean" },
            "at_step": { "type": "integer", "minimum": 1, "maximum": 30 },
            "undeclared_service": { "type": "string", "minLength": 1 },
            "undeclared_store": {
              "enum": ["postgres", "minio", "qdrant", "notify-log"]
            },
            "payload_version": { "type": "string", "minLength": 1 }
          }
        },
        "granularity": { "enum": ["task", "step"] },
        "observer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "probe": { "type": "boolean" }
          }
        },
        "cluster": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "node_count"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "node_count": { "type": "integer", "const": 1 }
          }
        }
      }
    }
  }
}
